{
  "steps": [
    {"action": "window", "id": "administration"},
    {"action": "wait", "seconds": 7},
    {"action": "menu", "path": ["Vixen Studio", "Settings…"]},
    {"action": "wait", "seconds": 1.5},
    {"action": "hook", "name": "studio.settings", "path": ["tab", "plugins"]},
    {"action": "wait", "seconds": 1},
    {"action": "hook", "name": "studio.plugins", "path": ["link", "@WORK@/dev/lamp"]},
    {"action": "wait", "seconds": 2.5},
    {"action": "hook", "name": "studio.settings", "path": ["tab", "general"]},
    {"action": "closeWindow"},
    {"action": "window", "id": "administration"},
    {"action": "wait", "seconds": 3.5},
    {"action": "studioSection", "name": "controllers"},
    {"action": "wait", "seconds": 4},
    {"action": "hook", "name": "setup.command", "path": ["controllerType", "Lamp"]},
    {"action": "hook", "name": "setup.command", "path": ["addController"]},
    {"action": "wait", "seconds": 0.6},
    {"action": "hook", "name": "setup.sheetAnswer", "path": ["Govee"]},
    {"action": "wait", "seconds": 0.8},
    {"action": "hook", "name": "setup.sheetAnswer", "path": ["3"]},
    {"action": "wait", "seconds": 3},
    {"action": "hook", "name": "studio.layout", "path": ["size", "1280", "800", "Vixen Studio"]},
    {"action": "wait", "seconds": 0.6},
    {"action": "studioControllersSelect", "name": "Govee"},
    {"action": "wait", "seconds": 2},
    {"action": "hook", "name": "studio.pluginForm", "path": ["paste", "{\"host\": \"10.0.0.30\", \"listLights\": true, \"lamps\": [{\"name\": \"Kitchen 1\"}, {\"name\": \"Kitchen 2\"}, {\"name\": \"Kitchen 3\"}, {\"name\": \"Kitchen 4\"}, {\"name\": \"Living Room Lamp\"}]}"]},
    {"action": "wait", "seconds": 2},
    {"action": "hook", "name": "studio.pluginForm", "path": ["state"]},
    {"action": "studioSection", "name": "display"},
    {"action": "wait", "seconds": 4},
    {"action": "hook", "name": "setup.stats", "path": []},
    {"action": "studioSingleBulbsFill", "text": "", "name": "Govee", "label": "Kitchen", "index": 0},
    {"action": "studioSingleBulbsOpen"},
    {"action": "wait", "seconds": 4},
    {"action": "snapshot", "name": "00-sheet-offer"},
    {"action": "wait", "seconds": 5},
    {"action": "click", "label": "Cancel"},
    {"action": "wait", "seconds": 1.5},
    {"action": "studioSingleBulbsFill", "text": "", "name": "Govee", "label": "Kitchen", "index": 1},
    {"action": "studioSingleBulbsOpen"},
    {"action": "wait", "seconds": 4},
    {"action": "snapshot", "name": "01-sheet-lights"},
    {"action": "wait", "seconds": 5},
    {"action": "dump", "name": "01-sheet-lights"},
    {"action": "click", "label": "Add Bulbs"},
    {"action": "wait", "seconds": 7},
    {"action": "hook", "name": "setup.selectElements", "path": ["Kitchen 1", "Kitchen 2", "Kitchen 3", "Kitchen 4", "Living Room Lamp"]},
    {"action": "hook", "name": "setup.stats", "path": []},
    {"action": "hook", "name": "studio.layout", "path": ["snapshot", "02-after", "Vixen Studio"]},
    {"action": "wait", "seconds": 5},
    {"action": "studioSingleBulbsFill", "text": "", "name": "Govee", "label": "", "index": 0},
    {"action": "studioSingleBulbsOpen"},
    {"action": "wait", "seconds": 4},
    {"action": "snapshot", "name": "03-sheet-all-patched"},
    {"action": "wait", "seconds": 5},
    {"action": "dump", "name": "03-sheet-all-patched"},
    {"action": "key", "key": "escape"},
    {"action": "wait", "seconds": 1},
    {"action": "quit"}
  ]
}
