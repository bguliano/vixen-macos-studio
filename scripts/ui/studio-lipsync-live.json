    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "state"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "map",
        "Singer"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "editorImage"
      ]
    },
    {
      "action": "snapshot",
      "name": "02-editor"
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "undoMenu"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "sendUndo"
      ]
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "map",
        "Singer"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "undoMenu"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "sendRedo"
      ]
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "map",
        "Singer"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "closeEditor"
      ]
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "clone",
        "Singer"
      ]
    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "default",
        "Singer"
      ]
    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "state"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "delete",
        "@clone"
      ]
    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "state"
      ]
    },
    {
      "action": "snapshot",
      "name": "04-library-after"
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "undoMenu"
      ]
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "sendUndo"
      ]
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "state"
      ]
    },
    {
      "action": "key",
      "key": "return"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "quit"
    }
