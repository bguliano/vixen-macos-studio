    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "focus",
      "window": "Christmas Can-Can"
    },
    {
      "action": "hook",
      "name": "sequencer.resize",
      "path": [
        "1400",
        "900"
      ]
    },
    {
      "action": "wait",
      "seconds": 6
    },
    {
      "action": "menu",
      "path": [
        "Tools",
        "LipSync",
        "Edit Image Maps"
      ]
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "state"
      ]
    },
    {
      "action": "snapshot",
      "name": "01-library"
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "new"
      ]
    },
    {
