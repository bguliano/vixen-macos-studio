      "seconds": 1.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "editorName",
        "Singer"
      ]
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "editorNotes",
