{
  "steps": [
    {
      "action": "wait",
      "seconds": 4
    },
    {
      "action": "focus",
      "window": "Vixen Studio"
    },
    {
      "action": "studioSection",
      "name": "sequences"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
