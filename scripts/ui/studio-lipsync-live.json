    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "picture",
        "AI",
        "{PICTURE}"
      ]
    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studioImageMaps",
      "path": [
        "picture",
        "REST",
