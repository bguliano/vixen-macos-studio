{
  "steps": [
    { "action": "wait", "seconds": 4 },
    { "action": "focus", "window": "Vixen Studio" },
    { "action": "studioSection", "name": "sequences" },
    { "action": "wait", "seconds": 1 },
    { "action": "studioDropFiles", "text": "Sequence/Christmas Can-Can.tim" },
    { "action": "wait", "seconds": 0.4 },
    { "action": "focus", "window": "Christmas Can-Can" },
    { "action": "hook", "name": "sequencer.resize", "path": ["1400", "900"] },
    { "action": "wait", "seconds": 10 },
    { "action": "hook", "name": "sequencer.tabs" },
    { "action": "dump", "name": "one-sequence" },
    { "action": "snapshot", "name": "one-sequence" },
    { "action": "focus", "window": "Vixen Studio" },
    { "action": "studioDropFiles", "text": "Sequence/Carey Grinch.tim" },
    { "action": "wait", "seconds": 0.4 },
    { "action": "focus", "window": "Carey Grinch" },
    { "action": "wait", "seconds": 10 },
    { "action": "hook", "name": "sequencer.tabs" },
    { "action": "snapshot", "name": "two-tabs" },
    { "action": "closeWindow" },
    { "action": "wait", "seconds": 2 },
    { "action": "hook", "name": "sequencer.tabs" },
    { "action": "quit" }
  ]
