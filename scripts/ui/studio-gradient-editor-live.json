    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "hook",
      "name": "studio.effectGradient",
      "path": [
        "state",
        "*"
      ]
    },
    {
      "action": "hook",
      "name": "sequencer.state"
    },
    {
      "action": "snapshot",
      "name": "02-gradient-editor-changed"
    },
    {
